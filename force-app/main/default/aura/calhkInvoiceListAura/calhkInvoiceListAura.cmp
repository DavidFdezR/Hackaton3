<aura:component controller="CalHK_InvoiceController" implements="force:hasRecordId,flexipage:availableForRecordHome" access="public" description="Invoices for the Account record page. Access control is enforced in CalHK_InvoiceController.">
    <aura:attribute name="recordId" type="Id" />
    <aura:attribute name="invoices" type="List" default="[]" />
    <aura:attribute name="columns" type="List" />
    <aura:attribute name="error" type="String" />
    <aura:attribute name="refreshSeconds" type="Integer" default="0" />
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />

    <lightning:card title="Invoices (Aura)" iconName="standard:contract">
        <lightning:datatable keyField="Id" data="{!v.invoices}" columns="{!v.columns}" hideCheckboxColumn="true" />
        <aura:if isTrue="{!not(empty(v.error))}">
            <p class="error slds-p-horizontal_small">{!v.error}</p>
        </aura:if>
    </lightning:card>
</aura:component>
