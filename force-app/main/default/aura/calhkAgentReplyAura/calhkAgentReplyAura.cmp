<aura:component implements="flexipage:availableForAllPageTypes" access="public" description="Aura view of an agent reply. Images load only from trusted hosts and every link shows its real host.">
    <aura:attribute name="reply" type="String" default="" />
    <aura:attribute name="segments" type="List" default="[]" />
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <aura:handler name="change" value="{!v.reply}" action="{!c.handleReplyChange}" />

    <lightning:card title="Agent (Aura)" iconName="utility:einstein">
        <div class="reply slds-p-horizontal_small">
            <aura:iteration items="{!v.segments}" var="seg">
                <aura:if isTrue="{!seg.isImage}">
                    <img class="reply-image" src="{!seg.src}" alt="{!seg.label}" />
                </aura:if>
                <aura:if isTrue="{!seg.isLink}">
                    <a href="{!seg.href}" target="_blank" rel="noopener noreferrer">{!seg.label}</a>
                    <span class="host"> ({!seg.host})</span>
                </aura:if>
                <aura:if isTrue="{!seg.isText}">
                    <span class="text">{!seg.text}</span>
                </aura:if>
            </aura:iteration>
        </div>
    </lightning:card>
</aura:component>
