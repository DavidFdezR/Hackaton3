/* global CalhkAura */
/**
 * AJ-02 · c:calhkInvoiceListAura · A-415 (async false pass), JAS-02 pattern (spy leakage)
 * Async specs must wait for the server callback; spies never leak across specs.
 */
describe('AJ-02 c:calhkInvoiceListAura', function () {
    let bundle;
    let component;

    beforeEach(function () {
        bundle = CalhkAura.load('calhkInvoiceListAura');
        component = CalhkAura.makeComponent({ recordId: '001xx0000000001AAA', refreshSeconds: 0 });
        spyOn(bundle.A, 'enqueueAction').and.callThrough();
    });

    it('waits for the server callback before asserting', function () {
        bundle.helper.loadInvoices(component);
        expect(bundle.A.enqueueAction).toHaveBeenCalledTimes(1);
        const action = bundle.A.queue[0];
        expect(action.getParams()).toEqual({ accountId: '001xx0000000001AAA' });

        action.respond('SUCCESS', [{ Id: 'a00xx0000000001AAA', Name: 'INV-0001', Amount__c: 10 }]);
        expect(component.values.invoices.length).toBe(1);
        expect(component.values.error).toBeNull();
    });

    it('fails the spec when the callback reports an error', async function () {
        const pending = bundle.helper.loadInvoices(component);
        bundle.A.queue[0].respond('ERROR', null, [{ message: 'internal detail' }]);
        expect(await pending).toBe('ERROR');
        expect(component.values.error).toBe('Invoices could not be loaded.');
        expect(component.values.invoices).toEqual([]);
    });

    it('wraps async re-entry in $A.getCallback', async function () {
        const before = bundle.A.getCallbackCalls;
        const pending = bundle.helper.loadInvoices(component);
        expect(bundle.A.getCallbackCalls).toBe(before + 1);
        bundle.A.queue[0].respond('SUCCESS', []);
        expect(await pending).toBe('SUCCESS');

        component.values.refreshSeconds = 60;
        bundle.helper.scheduleRefresh(component);
        expect(bundle.timers.length).toBe(1);
        expect(bundle.timers[0].ms).toBe(60000);
        expect(bundle.A.getCallbackCalls).toBe(before + 2);
    });

    it('starts each spec with a fresh enqueueAction spy (no leakage)', function () {
        expect(bundle.A.enqueueAction.calls.count()).toBe(0);
    });

    it('declares no design attribute that changes access or approval behaviour', function () {
        const design = bundle.design();
        expect(design).not.toMatch(/name="(adminMode|skipApproval|bypass\w*|debugMode|showAll\w*)"/i);
        expect(design).not.toMatch(/default="true"/i);
    });
});
